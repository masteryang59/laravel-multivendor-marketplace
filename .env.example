APP_NAME=Bazaar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# npm run serve listens on 8029; docker compose maps 8080.
APP_URL=http://127.0.0.1:8029

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite for local work; docker compose switches to MySQL.
DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite
# "persist" keeps SQLite's journal file instead of deleting it after every
# transaction (deletes can fail on Windows while antivirus holds the file).
DB_JOURNAL_MODE=persist
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketplace
# DB_USERNAME=marketplace
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Webhook deliveries and email go through the queue (npm run serve runs a worker).
QUEUE_CONNECTION=database
CACHE_STORE=database

# "log" writes mail to storage/logs/laravel.log; compose uses Mailpit (smtp).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@bazaar.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Marketplace -----------------------------------------------------------
MARKETPLACE_CURRENCY=USD
MARKETPLACE_COMMISSION_BPS=1000
MARKETPLACE_RESERVATION_MINUTES=30
MARKETPLACE_PAYOUT_HOLD_DAYS=7
MARKETPLACE_MINIMUM_PAYOUT_CENTS=1000
# Lists the seeded demo logins on the sign-in page.
MARKETPLACE_DEMO=true

# FakePay, the built-in stand-in payment provider. Change the secret anywhere
# that isn't your laptop. FAKEPAY_WEBHOOK_URL overrides where FakePay POSTs
# webhooks (default: this app's /webhooks/fakepay).
PAYMENT_DRIVER=fakepay
FAKEPAY_WEBHOOK_SECRET=whsec_local_development_only
# FAKEPAY_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
REVOKE_ACCESS=enabled
REFRESH_TOKEN=enabled